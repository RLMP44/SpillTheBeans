<!-- app/views/shared/_card_layout.html.erb -->
<div class="title-container">
  <%# ------------------ name of collection --------------------- %>
  <% if defined?(collection_name) && collection_name.present? %>
    <h2><%= collection_name %></h2>
  <% else %>
    <h2><%= t(".#{item_type}") %>s</h2>
  <% end %>
  <div class="recipes-container main-background-color">
    <%# ------------------ create cards --------------------- %>
    <% if collection.exists? %>
      <% collection.each do |item| %>
        <%= render partial: "shared/#{item_type}_card", locals: { item_type => item, item: item } %>
      <% end %>
    <% else %>
      <h2>No <%= ("#{item_type}") %>s yet!</h2>
    <% end %>
    <%# ------------------ handle create buttons --------------------- %>
    <% if defined?(show_create) && show_create %>
      <!-- Modal -->
      <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="exampleModalLabel">Create <%= t(".#{item_type}") %></h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <%= render partial: "shared/create_#{item_type}_button", locals: { item_type: item_type, list: (defined?(list) ? list : nil), recipe: (defined?(recipe) ? recipe : nil) } %>
            </div>
          </div>
        </div>
      </div>
      <!-- Button trigger modal -->
      <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#exampleModal">Create <%= t(".#{item_type}") %></button>
    <% end %>
  </div>
</div>
