<%= render partial: 'shared/card_layout', locals: { collection: @recipes, item_type: 'recipe' } %>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Create a new recipe</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= simple_form_for @recipe do |f| %>
          <%= f.input :name, prompt: "Name of Recipe" %>
          <%= f.input :description, prompt: "Description" %>
          <%= f.input :cook_time, prompt: "Cook Time" %>
          <%= f.input :difficulty, prompt: "Difficulty" %>
          <%= f.label :oven, "Does this recipe need an oven?" %>
          <%= f.select :oven, [['Yes', true], ['No', false]], include_blank: false %>
          <%= f.input :oven_temp, prompt: "Oven Temperature" %>
          <%= f.input :total_time, prompt: "Total Time" %>
          <%= f.input :ingredients, prompt: "Ingredients (separated by commas)" %>
          <%= f.input :instructions, prompt: "Instructions" %>

          <%#= f.input :photo, as: :file %>
          <%= f.button :submit %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<!-- Button trigger modal -->
<button type="button" class="floating-button" data-bs-toggle="modal" data-bs-target="#exampleModal">
  +
</button>
