<h1><%= @list.title %></h1>
<% @list.bookmarks.each do |bookmark| %>
  <%= bookmark.recipe.name %>
  <% if @list.user == current_user %>
    <%= link_to "Delete", bookmark_path(bookmark),
    data: {turbo_method: :delete, turbo_confirm: "Are you sure?"},
    class:"btn btn-outline-danger btn-sm pt-3" %>
  <% end %>
<% end %>

<%= link_to "Back", lists_path, class:"btn btn-primary btn-sm pt-3" %>
<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Add a new recipe</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= simple_form_for [@list, @bookmark] do |f| %>
          <%= f.label :recipe, "Recipe" %>
          <%= f.select :recipe_id, options_from_collection_for_select(@recipes, 'first', 'last'), prompt: "Select a Recipe" %>
          <%#= f.input :photo, as: :file %>
          <%= f.input :comment %>
          <%= f.button :submit %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<!-- Button trigger modal -->
<% if @list.user == current_user %>
  <button type="button" class="floating-button" data-bs-toggle="modal" data-bs-target="#exampleModal">
    +
  </button>
<% end %>
