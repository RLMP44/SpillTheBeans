<div class="card">
  <div class="cover">
    <%#= link_to list.title, list_path(list), class:"btn btn-primary btn-sm pt-3" %>
    <%= image_tag("placeholder.png", alt: 'placeholder', class: 'h-16, recipe-card-image')%>
    <%#= list.photo.key.present? ? cl_image_tag(experience.photo.key, class:"position-relative") : image_tag("super_mario_arena.gif", class: "position-relative") %>
    <h1><%= list.title %></h1>
    <div class="card-back">
      <%= link_to 'View List', list_path(list), :class => "link-button" %>
    </div>
  </div>
</div>
